# This file is a key inventory only. Store the real values in one Secret Manager
# secret per environment; never commit the populated file.
APP_ENV=production
ALLOWED_ORIGINS=https://lekhacaptions.com,https://www.lekhacaptions.com,https://app.lekhacaptions.com
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=
GCS_MEDIA_BUCKET=lekha-media-project-0cc7c839-b9c7-4734-ad0
# Set to `terraform output -raw gcs_signing_service_account` in the protected runtime secret.
GCS_SIGNING_SERVICE_ACCOUNT=
OPENAI_API_KEY=
SARVAM_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RECONCILE_SECRET=
REDIS_URL=
MEDIA_URL_SIGNING_SECRET=
ADMIN_EMAILS=
SECURITY_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
SLACK_ALERT_WEBHOOK_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
FIREBASE_APP_CHECK_ENFORCED=1
ENABLE_DURABLE_QUEUE=1
EXPORT_QUEUE_NAME=caption_export_jobs
FAST_EXPORT_QUEUE_NAME=caption_export_fast
HEAVY_EXPORT_QUEUE_NAME=caption_export_heavy
GPU_EXPORT_QUEUE_NAME=caption_export_gpu
GPU_RENDER_ENABLED=0
TRANSCRIPTION_QUEUE_NAME=caption_transcription_jobs
MEDIA_SCAN_QUEUE_NAME=caption_media_scan_jobs
EXPORT_MAX_PENDING_JOBS=80
EXPORT_MAX_QUEUE_WAIT_SECONDS=600
QUEUE_METRICS_ENABLED=1
QUEUE_METRICS_INTERVAL_SECONDS=30
WORKER_MIG_NAME=lekha-worker-staging-mig
SPOT_WORKER_MIG_NAME=lekha-worker-spot-staging-mig
GPU_WORKER_MIG_NAME=lekha-worker-gpu-staging-mig
TRANSCRIPTION_MIG_NAME=lekha-transcription-staging-mig
TRANSCRIPTION_PROVIDER_FAILOVER=1
# Cloud Scheduler owns recurring dispatch/recovery/metrics in production.
RUN_API_BACKGROUND_TASKS=0
WEB_CONCURRENCY=2
UVICORN_LIMIT_CONCURRENCY=64
UVICORN_BACKLOG=512
UVICORN_KEEP_ALIVE_SECONDS=10
MAX_CONCURRENT_RENDERS=1
AI_SYSTEM_DAILY_LIMIT=50
PUPPETEER_DISABLE_SANDBOX=0
DISABLE_EXPORT_DAILY_LIMIT=0
DISABLE_EXPORT_CREDIT_LIMIT=0
EXPORT_VIDEO_ENCODER=cpu
RELEASE_ENVIRONMENT=staging
APP_RELEASE=
RELEASE_VERSION=
APP_BUILD_TIME=
