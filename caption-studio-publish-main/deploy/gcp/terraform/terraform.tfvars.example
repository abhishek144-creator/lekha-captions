project_id                  = "project-0cc7c839-b9c7-4734-ad0"
release                     = "0000000000000000000000000000000000000000"
runtime_image               = "projects/PROJECT/global/images/lekha-runtime-RELEASE"
api_image_uri               = "asia-south1-docker.pkg.dev/PROJECT/caption-studio/api@sha256:DIGEST"
render_image_uri            = "asia-south1-docker.pkg.dev/PROJECT/caption-studio/render@sha256:DIGEST"
transcription_image_uri     = "asia-south1-docker.pkg.dev/PROJECT/caption-studio/transcription@sha256:DIGEST"
runtime_secret_version      = 1
runtime_service_account     = "SERVICE_ACCOUNT@PROJECT.iam.gserviceaccount.com"
media_bucket_name           = "lekha-media-PROJECT"
render_worker_machine_type  = "n2-highcpu-8"
render_worker_min_replicas  = 0
render_worker_max_replicas  = 3
render_worker_disk_size_gb  = 100
render_worker_disk_type     = "pd-ssd"
spot_render_worker_max_replicas = 5

# Enables the production Cloud Run API, its private Redis connector, serverless
# NEG, and OIDC-authenticated maintenance jobs. Load-balancer traffic is still
# switched only after the deployment runbook's health and load gates pass.
enable_cloud_run_api = true
cloud_run_api_min_instances = 0
# Mirror this into Artifact Registry and pin a digest before enabling Cloud Run.
clamav_image_uri = "clamav/clamav:1.4_base"
