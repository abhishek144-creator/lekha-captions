project_id              = "NEW_PROJECT_ID"
release                 = "0000000000000000000000000000000000000000"
api_image_uri           = "asia-south1-docker.pkg.dev/PROJECT/caption-studio/api@sha256:DIGEST"
render_image_uri        = "asia-south1-docker.pkg.dev/PROJECT/caption-studio/render@sha256:DIGEST"
transcription_image_uri = "asia-south1-docker.pkg.dev/PROJECT/caption-studio/transcription@sha256:DIGEST"
# Mirror this into Artifact Registry and pin a digest.
clamav_image_uri        = "clamav/clamav:1.4"
runtime_secret_version  = 1
runtime_service_account = "lekha-runtime@PROJECT.iam.gserviceaccount.com"
media_bucket_name       = "lekha-media-PROJECT"

# Hard caps. Raise only with measured cost evidence.
api_max_instances           = 2
worker_max_parallel         = 1
worker_idle_exit_seconds    = 120
worker_task_timeout_seconds = 7200
enable_gpu_render_job       = false

# Budget: emails at 50/80/100% and an automatic pause of uploads,
# transcription and exports at budget_stop_fraction of the monthly budget.
billing_account_id   = "012345-6789AB-CDEF01"
monthly_budget       = 1000
budget_currency      = "INR"
budget_stop_fraction = 1.0
