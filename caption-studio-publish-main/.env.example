# Runtime: set to development locally and production only in the production service.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Public frontend origin of the API. Leave empty only when /api is reverse-proxied
# on the same origin as the frontend.
VITE_API_BASE_URL=
# Optional separate editor origin for marketing-only builds. Dashboard and login
# calls-to-action remain same-origin when this is empty.
VITE_EDITOR_URL=
# Set to 1 only when the deployed frontend reverse-proxies /api to the backend.
VITE_ALLOW_SAME_ORIGIN_API=0

# Public browser configuration. These values identify Firebase resources but do
# not grant server privileges; Firebase Security Rules remain authoritative.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Public reCAPTCHA Enterprise site key registered for this web app in Firebase
# App Check. Production builds fail when this is missing.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_RAZORPAY_KEY_ID=
VITE_SUPPORT_EMAIL=support@lekhacaptions.com
# Public legal identity rendered in Terms, Privacy, and Refund pages. Production
# builds fail when these are blank so a generic product name cannot accidentally
# be published in place of the registered seller/controller.
VITE_LEGAL_BUSINESS_NAME=
VITE_LEGAL_BUSINESS_ADDRESS=
VITE_GOVERNING_VENUE=
# Public grievance contact required for consumer and privacy complaints. Use the
# appointed person's name/designation and a monitored company mailbox.
VITE_GRIEVANCE_OFFICER_NAME=
VITE_GRIEVANCE_EMAIL=support@lekhacaptions.com
# Exact Git SHA embedded in the frontend. CI/Netlify may derive this from the
# checkout, but an explicit value is recommended for controlled deployments.
VITE_APP_RELEASE=

# Firebase Admin (server only). Use a secret manager in deployed environments.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=

# AI providers (server only; never prefix these with VITE_ or NEXT_PUBLIC_).
OPENAI_API_KEY=
SARVAM_API_KEY=
TRANSCRIPTION_PROVIDER_TIMEOUT_SECONDS=180
AUDIO_EXTRACTION_TIMEOUT_SECONDS=120

# Payments (server only). Use Razorpay test credentials outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required production infrastructure and signing secrets.
REDIS_URL=
ENABLE_DURABLE_QUEUE=1
MEDIA_URL_SIGNING_SECRET=
ADMIN_EMAILS=
SECURITY_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
PROCESS_SLOT_TTL_SECONDS=1800
MAX_CONCURRENT_RENDERS=2
TEMPLATE_OVERLAY_MAX_FRAMES=3600
PUPPETEER_DISABLE_SANDBOX=0

# Per-plan daily export quotas. Enabled in every environment. Set to 1 only for
# a deliberate, temporary local export-debugging session.
DISABLE_EXPORT_DAILY_LIMIT=0
# Platform-wide ceiling on billable AI provider calls (transcription, translate,
# language detect) per UTC day, across ALL users. Per-user quotas bound what one
# account spends; this bounds the whole day's bill. Raise it as capacity is
# proven; 0 disables the ceiling entirely.
AI_SYSTEM_DAILY_LIMIT=500
# How long the operator kill switches (ops/service_controls in Firestore) are
# cached in-process before being re-read. Lower reacts faster, costs more reads.
SERVICE_CONTROL_CACHE_SECONDS=10

# Optional operations integrations.
SLACK_ALERT_WEBHOOK_URL=
# Malware scan command for uploads, e.g. "clamdscan". REQUIRED when
# APP_ENV=production — the backend refuses to boot without it, because an unset
# value silently skips scanning. The unscanned-upload override is development-only.
# On the transcription service only, use CLAMAV_HOST=127.0.0.1: its Docker
# target starts clamd. Leave empty on API/render/cron, which do not run clamd.
# Keep CLAMAV_SCAN_CMD configured as fallback while clamd loads signatures.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_SCAN_CMD=
# clamscan loads its whole signature database per scan; the Railway images run
# "clamscan --stdout --database=/opt/clamav-db" with 120 here.
CLAMAV_SCAN_TIMEOUT_SECONDS=20
ALLOW_UNSCANNED_UPLOADS=0

# Error tracking. The browser DSN is public configuration and may share the
# same Sentry project or use a dedicated frontend project.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_DSN=
APP_RELEASE=
FIREBASE_APP_CHECK_ENFORCED=1

# Export video encoder: auto (use NVENC when the host really supports it),
# cpu (force libx264), or nvenc (force GPU). auto falls back to libx264 both
# when the probe fails and when a GPU encode fails at runtime.
EXPORT_VIDEO_ENCODER=auto

# Synthetic health monitor (scripts/check-synthetic-health.mjs).
SYNTHETIC_BASE_URL=
SYNTHETIC_ADMIN_TOKEN=
SYNTHETIC_EXPECTED_RELEASE=
SYNTHETIC_DNS_HOSTS=lekhacaptions.com,app.lekhacaptions.com,api.lekhacaptions.com

# Same non-secret identity for editor, marketing, API and every worker.
# Set APP_RELEASE/VITE_APP_RELEASE to the exact reviewed 40-character Git SHA.
APP_BUILD_TIME=
RELEASE_VERSION=
RELEASE_ENVIRONMENT=production
# Comma-separated private worker health origins, used only by deployment verifier.
DEPLOY_VERIFY_WORKER_URLS=
DEPLOY_VERIFY_ENVIRONMENT=production

# Railway scale-to-zero (docs/RAILWAY_DEPLOYMENT.md; .railway/railway.ts sets these).
# Docker stage each service builds: api | transcription | render.
LEKHA_SERVICE_TARGET=
# 0 on Railway: lekha-cron does dispatch recovery, cleanup and reconciliation so
# an idle API can sleep.
RUN_API_BACKGROUND_TASKS=1
# Queue name -> worker name, and worker name -> private /wake URL (JSON objects).
WORKER_LAUNCH_JOBS=
WORKER_WAKE_URLS=
WORKER_WAKE_SECRET=
# Worker services only: this worker's name in WORKER_LAUNCH_JOBS.
WORKER_LAUNCH_JOB_NAME=
WORKER_WAKE_SCHEDULED_WAIT_SECONDS=330

# Railway replica autoscaling. Defaults to off outside Railway. IaC sets both
# maxima to 5, the Hobby plan ceiling; never set above your plan's limit.
RENDER_AUTOSCALE_ENABLED=0
RENDER_AUTOSCALE_SERVICE_ID=
RENDER_AUTOSCALE_MAX_REPLICAS=3
TRANSCRIPTION_AUTOSCALE_ENABLED=0
TRANSCRIPTION_AUTOSCALE_SERVICE_ID=
TRANSCRIPTION_AUTOSCALE_MAX_REPLICAS=3
# Firebase token verification cache lifetime; 0 disables. Tokens expire no
# later than their own expiry, and verification is cached for at most 60 s.
FIREBASE_TOKEN_CACHE_SECONDS=60
# Redis plan memory in bytes. Cron alerts at 80%; set to the actual plan size
# when Redis does not expose maxmemory (default here: 512 MiB).
REDIS_MEMORY_ALERT_BYTES=536870912
# Bound on in-process export job records per API process (minimum 100).
EXPORT_JOB_LOCAL_CACHE_MAX=2000

# Cloudflare R2 (S3-compatible). Browsers upload straight to R2 in 8 MiB parts.
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_ADDRESSING_STYLE=path
